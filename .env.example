# Example environment overrides. Copy to .env and edit as needed.
# Any config.yaml value can be overridden with LEADENGINE_ + nested keys joined by "__".

# Database (SQLite by default).
# LEADENGINE_DATABASE__URL=sqlite+pysqlite:///data/leadengine.db

# Logging.
# LEADENGINE_LOG_LEVEL=INFO
# LEADENGINE_LOG_JSON=1

# Fetcher politeness.
# LEADENGINE_FETCHER__DEFAULT_RATE_LIMIT=1.0
# LEADENGINE_FETCHER__RESPECT_ROBOTS=true
# LEADENGINE_FETCHER__TIMEOUT=15

# Optional monetization intelligence layer.
# LEADENGINE_MONETIZATION__ENABLED=true
# LEADENGINE_MONETIZATION__AFFECT_SCORE=false

# Reproducible timestamps (mainly for demos/tests). Leave unset in production.
# LEADENGINE_FROZEN_NOW=2026-06-28T12:00:00

# Point at an alternate config directory.
# LEADENGINE_CONFIG_DIR=/app/config
