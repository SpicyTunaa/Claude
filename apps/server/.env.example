# --- Telegram ---
# Token issued by @BotFather. Used to validate Telegram initData signatures.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call the API (your Mini App URL).
CORS_ORIGINS=http://localhost:3000

# Reject initData older than this many seconds (replay protection). 0 disables.
INITDATA_MAX_AGE_SECONDS=86400

# Set to "true" to allow requests without valid initData (LOCAL DEV ONLY).
ALLOW_INSECURE_AUTH=false

# --- Face swap provider ---
# Which provider implementation to use: "magicapi" | "mock"
# "mock" needs no credentials and echoes the source image back — ideal for dev.
FACE_SWAP_PROVIDER=mock

# MagicAPI (https://api.market) credentials
MAGICAPI_KEY=
MAGICAPI_BASE_URL=https://api.magicapi.dev/api/v1/magicapi/faceswap
